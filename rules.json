{
  "format": "sentinel-rules-1",
  "version": "2026.10.30.2",
  "macros": {
    "gap": "(?:\\s|/\\*(?:[^*]|\\*(?!/))*\\*/|#[^\\n]*\\n|//[^\\n]*\\n)*",
    "request": "\\$_(?:GET|POST|REQUEST|COOKIE)",
    "anyinput": "\\$_(?:GET|POST|REQUEST|COOKIE|SERVER|FILES)",
    "exec": "(?:eval|assert|system|exec|shell_exec|passthru|popen|proc_open|pcntl_exec)",
    "decoder": "(?:base64_decode|gzinflate|gzuncompress|gzdecode|str_rot13|convert_uudecode|hex2bin)",
    "notmethod": "(?<![>:\\w$])",
    "notcomment": "^(?![ \\t]*(?:\\*|//|#))[^\\n]*?"
  },
  "file_rules": [
    {"id": "dynamic-decoding", "severity": "high", "applies_to": ["php"],
     "literals": ["eval", "assert"],
     "all": ["{notmethod}(?:eval|assert){gap}\\({gap}@?{gap}{decoder}{gap}\\("],
     "reason": "Dynamic execution directly wrapping encoded or compressed content."},
    {"id": "request-execution", "severity": "high", "applies_to": ["php"],
     "literals": ["$_"],
     "all": ["{notmethod}{exec}{gap}\\({gap}@?{gap}{anyinput}\\b"],
     "reason": "Execution function directly receives request-controlled input."},
    {"id": "request-variable-execution", "severity": "high", "applies_to": ["php"],
     "literals": ["$_"],
     "all": ["\\$([A-Za-z_]\\w*){gap}={gap}@?{gap}{anyinput}{gap}\\[[^\\]\\n]{0,64}\\][^;\\n]{0,64};[\\s\\S]{0,500}?{notmethod}{exec}{gap}\\({gap}@?{gap}\\$\\1\\b"],
     "reason": "Request input is copied to a variable that is then executed."},
    {"id": "decoded-variable-execution", "severity": "high", "applies_to": ["php"],
     "literals": ["eval", "assert"],
     "all": ["\\$([A-Za-z_]\\w*){gap}={gap}[^;\\n]{0,200}{decoder}{gap}\\([^;\\n]{0,200};[\\s\\S]{0,2000}?{notmethod}(?:eval|assert){gap}\\({gap}@?{gap}\\$\\1\\b"],
     "reason": "Decoded data is stored in a variable that is then executed."},
    {"id": "request-function-name", "severity": "high", "applies_to": ["php"],
     "literals": ["$_"],
     "all": ["{request}{gap}\\[[^\\]\\n]{0,64}\\]{gap}\\("],
     "reason": "The name of the function being called comes directly from the request."},
    {"id": "callback-execution", "severity": "high", "applies_to": ["php"],
     "literals": ["array_map", "array_filter", "array_walk", "array_reduce", "call_user_func", "forward_static_call", "register_shutdown_function", "register_tick_function", "ob_start", "iterator_apply", "usort", "uasort", "uksort"],
     "all": ["\\b(?:array_map|call_user_func|call_user_func_array|forward_static_call|register_shutdown_function|register_tick_function|ob_start|iterator_apply){gap}\\({gap}['\"]{exec}['\"]|\\b(?:array_filter|array_walk|array_reduce|usort|uasort|uksort){gap}\\([^;\\n]{0,200},{gap}['\"]{exec}['\"]"],
     "reason": "An execution function is passed as a callback by name."},
    {"id": "callback-request", "severity": "high", "applies_to": ["php"],
     "literals": ["array_map", "array_filter", "array_walk", "array_reduce", "call_user_func", "forward_static_call", "register_shutdown_function", "register_tick_function", "ob_start", "iterator_apply", "usort", "uasort", "uksort"],
     "all": ["\\b(?:array_map|call_user_func|call_user_func_array|forward_static_call|register_shutdown_function|ob_start){gap}\\({gap}@?{gap}{request}{gap}\\["],
     "reason": "The callback being run comes directly from the request."},
    {"id": "preg-replace-eval", "severity": "high", "applies_to": ["php"],
     "literals": ["preg_replace"],
     "all": ["\\bpreg_replace{gap}\\({gap}(['\"])(.)(?:(?!\\1)[^\\n]){0,300}\\2[imsxuADSUXJ]*e[imsxuADSUXJ]*\\1"],
     "reason": "preg_replace with the /e modifier executes its replacement as PHP (removed in PHP 7)."},
    {"id": "create-function-request", "severity": "high", "applies_to": ["php"],
     "literals": ["create_function"],
     "all": ["\\bcreate_function{gap}\\([^;\\n]{0,200}{request}"],
     "reason": "create_function builds code from request input."},
    {"id": "request-include", "severity": "high", "applies_to": ["php"],
     "literals": ["$_"],
     "flags": "im",
     "all": ["{notcomment}(?<![\\w$>'\"-])(?:include|require)(?:_once)?\\b(?!['\"]){gap}\\(?[^;\\n]{0,120}{request}"],
     "reason": "A file to include is chosen by request input."},
    {"id": "remote-code-include", "severity": "high", "applies_to": ["php"],
     "literals": ["://"],
     "all": ["\\b(?:include|require)(?:_once)?\\b{gap}\\(?{gap}@?{gap}['\"](?:https?|ftp|php|data)://"],
     "reason": "Code is included from a remote or stream location."},
    {"id": "upload-dropper", "severity": "high", "applies_to": ["php"],
     "literals": ["move_uploaded_file"],
     "all": ["\\bmove_uploaded_file{gap}\\([^;\\n]{0,200},{gap}@?{gap}{request}"],
     "reason": "An uploaded file is saved to a path chosen by the request."},
    {"id": "request-path-write", "severity": "high", "applies_to": ["php"],
     "literals": ["$_"],
     "all": ["\\b(?:file_put_contents|fopen|copy){gap}\\({gap}@?{gap}{request}{gap}\\["],
     "reason": "A file path to write or copy comes directly from the request."},
    {"id": "backtick-request", "severity": "high", "applies_to": ["php"],
     "literals": ["`"],
     "flags": "im",
     "all": ["{notcomment}(?:[=(,.;]|\\b(?:echo|print|return))\\s*`[^`\\n]{0,200}{anyinput}[^`\\n]{0,200}`"],
     "reason": "A shell command in backticks contains request input."},
    {"id": "obfuscated-function-name", "severity": "high", "applies_to": ["php"], "scope": "normalized",
     "all": ["['\"](?:eval|assert|base64_decode|gzinflate|gzuncompress|str_rot13|shell_exec|passthru|system|exec|popen|proc_open|create_function|call_user_func|file_put_contents|move_uploaded_file)['\"]"],
     "reason": "A sensitive function name only appears after joining string pieces or decoding escapes. Line number is not available."},
    {"id": "encoded-php", "severity": "medium", "applies_to": ["php"],
     "literals": ["base64_decode", "gzinflate", "gzuncompress", "gzdecode", "str_rot13", "convert_uudecode", "hex2bin"],
     "all": ["{decoder}{gap}\\({gap}['\"][A-Za-z0-9+/=]{300,}"],
     "reason": "Long embedded encoded string decoded by PHP; review its purpose."},
    {"id": "eval-of-variable", "severity": "medium", "applies_to": ["php"],
     "literals": ["eval"],
     "all": ["{notmethod}eval{gap}\\({gap}@?{gap}\\$[A-Za-z_]"],
     "reason": "eval runs the contents of a variable. Template engines can do this legitimately; check where the value comes from."},
    {"id": "variable-function-request", "severity": "medium", "applies_to": ["php"],
     "literals": ["$_"],
     "all": ["(?<![>:\\w])\\$[A-Za-z_]\\w*{gap}\\({gap}@?{gap}{request}{gap}\\["],
     "reason": "A function held in a variable receives request input. Sanitizing callbacks can do this legitimately; check the variable's source."},
    {"id": "create-function", "severity": "medium", "applies_to": ["php"],
     "literals": ["create_function"],
     "all": ["\\bcreate_function{gap}\\("],
     "reason": "create_function builds code from a string and was removed in PHP 8. Often old code; rarely needed."},
    {"id": "remote-file-dropper", "severity": "medium", "applies_to": ["php"],
     "literals": ["file_put_contents"],
     "all": ["\\bfile_put_contents{gap}\\([^;\\n]{0,300}\\b(?:file_get_contents|curl_exec|wp_remote_retrieve_body)\\b"],
     "reason": "Remote or fetched content is written straight to a file. Caches can do this; check the destination."},
    {"id": "include-non-code-file", "severity": "medium", "applies_to": ["php"],
     "literals": ["include", "require"],
     "all": ["\\b(?:include|require)(?:_once)?\\b{gap}\\(?{gap}@?{gap}['\"][^'\"\\n]{1,200}\\.(?:ico|png|jpe?g|gif|webp|svg|txt|log|tmp|bak|zip)['\"]"],
     "reason": "PHP includes a file that is not named as code, a common way to hide a payload."},
    {"id": "chr-chain", "severity": "medium", "applies_to": ["php"],
     "literals": ["chr"],
     "all": ["(?:\\bchr{gap}\\({gap}\\d+{gap}\\){gap}\\.{gap}){8,}"],
     "reason": "A long chain of chr() calls builds a string character by character."},
    {"id": "hex-string", "severity": "medium", "applies_to": ["php"],
     "literals": ["\\x"],
     "all": ["(?:\\\\x[2-7][0-9a-fA-F]){16,}"],
     "reason": "A long hex-escaped string of readable characters; check what it decodes to."},
    {"id": "globals-function-call", "severity": "medium", "applies_to": ["php"],
     "literals": ["$globals"],
     "all": ["\\$GLOBALS{gap}\\[[^\\]\\n]{0,64}\\]{gap}(?:\\[[^\\]\\n]{0,64}\\]{gap})?\\("],
     "reason": "A function is called through $GLOBALS, a common obfuscation pattern."},
    {"id": "admin-account-creation", "severity": "review", "applies_to": ["php"],
     "literals": ["wp_insert_user", "wp_create_user"],
     "exclude_paths": ["wp-admin/", "wp-includes/"],
     "all": ["\\bwp_(?:insert|create)_user{gap}\\(", "['\"]administrator['\"]"],
     "reason": "Code creates users and mentions the administrator role. Installers can do this; backdoors also do."},
    {"id": "javascript-obfuscation", "severity": "medium", "applies_to": ["js", "php"],
     "literals": ["eval"],
     "all": ["\\beval\\s*\\(\\s*(?:atob|unescape|String\\.fromCharCode)\\s*\\("],
     "reason": "JavaScript executes decoded content; legitimate scripts can also do this."},
    {"id": "javascript-document-write-decoded", "severity": "medium", "applies_to": ["js", "php"],
     "literals": ["document.write"],
     "all": ["\\bdocument\\.write\\s*\\(\\s*(?:unescape|atob|String\\.fromCharCode)\\s*\\("],
     "reason": "JavaScript writes decoded content into the page, a common injection pattern."},
    {"id": "htaccess-non-code-execution", "severity": "high", "applies_to": ["htaccess"],
     "all": ["(?:AddHandler|AddType|Action)\\s+\\S*(?:php|x-httpd)\\S*\\s+[^\\n]*\\.(?:jpe?g|png|gif|ico|webp|svg|txt|bmp|pdf|html?|css|js)\\b|<Files(?:Match)?[^>\\n]*(?:jpe?g|png|gif|ico|webp|txt)[^>\\n]*>\\s*SetHandler\\s+\\S*php"],
     "reason": "Server configuration runs non-code file types as PHP."},
    {"id": "htaccess-php-enabled-in-uploads", "severity": "high", "applies_to": ["htaccess"],
     "only_paths": ["wp-content/uploads/"],
     "all": ["(?:AddHandler|AddType|SetHandler)\\s+\\S*(?:php|x-httpd)|php_(?:flag|value)\\s+engine\\s+on"],
     "reason": "Upload folder configuration turns PHP on. Uploads should not need this."},
    {"id": "htaccess-crawler-rule", "severity": "review", "applies_to": ["htaccess"],
     "all": ["RewriteCond\\s+%\\{HTTP_(?:USER_AGENT|REFERER)\\}[^\\n]*(?:google|bing|yahoo|yandex|baidu)"],
     "reason": "Rewrite rule depends on a search engine's name. Used by bot blockers, and by SEO spam that shows different pages to crawlers."},
    {"id": "htaccess-external-redirect", "severity": "review", "applies_to": ["htaccess"],
     "flags": "im",
     "all": ["^\\s*RewriteRule\\s+\\S+\\s+\"?https?://(?!%\\{)"],
     "reason": "Rewrite rule redirects to a fixed external address. Check that the destination is yours."}
  ],
  "database_rules": [
    {"id": "db-encoded-execution", "severity": "high",
     "pattern": "/\\b(?:eval|assert)\\s*\\(\\s*(?:base64_decode|gzinflate|gzuncompress|atob|unescape)\\s*\\(/i",
     "reason": "Stored content includes execution of decoded data. Review context; code examples can also match."},
    {"id": "db-obfuscated-javascript", "severity": "high",
     "pattern": "/\\beval\\s*\\(\\s*String\\.fromCharCode\\b|String\\.fromCharCode\\s*\\(\\s*\\d+\\s*(?:,\\s*\\d+\\s*){16,}\\)/i",
     "reason": "Stored JavaScript is built from character codes, a common injection pattern."},
    {"id": "db-script-tag", "severity": "medium",
     "pattern": "/<script\\b/i",
     "reason": "Stored script element. May be intentional analytics, embeds, or a code example."},
    {"id": "db-php-tag", "severity": "medium",
     "pattern": "/<\\?php\\b/i",
     "reason": "Stored PHP code. May be a snippet plugin or a code example."},
    {"id": "db-hidden-iframe", "severity": "medium",
     "pattern": "/<iframe\\b[^>]*(?:\\b(?:width|height)\\s*=\\s*[\"']?[01][\"'\\s>]|display\\s*:\\s*none|visibility\\s*:\\s*hidden)/i",
     "reason": "Stored iframe that is hidden or one pixel in size."},
    {"id": "db-hidden-link-block", "severity": "review",
     "pattern": "/<(?:div|span)\\b[^>]*(?:display\\s*:\\s*none|left\\s*:\\s*-\\d{3,}px)[^>]*>\\s*<a\\s/i",
     "reason": "Links inside a hidden block, a common sign of SEO spam."}
  ]
}
